# Notebook Studio — Server Configuration
# Copy this file to .env and change the values

PORT=27972
JWT_SECRET=change-this-to-a-random-string-at-least-32-chars
ADMIN_USERNAME=admin@notebook.com
ADMIN_PASSWORD=change-this-to-a-secure-password

# Bilingual App Integration (Server-to-Server)
BILINGUAL_APP_URL=http://127.0.0.1:27099
BILINGUAL_CLIENT_ID=notebook_client_v1

# Notebook Studio — Server Configuration
# Copy this file to .env and change the values

PORT=27972
JWT_SECRET=change-this-to-a-random-string-at-least-32-chars
ADMIN_USERNAME=admin@notebook.com
ADMIN_PASSWORD=change-this-to-a-secure-password

# Keep false for browser clients. Enable only when a trusted native client
# requires the JWT in the login response and cannot use the HttpOnly cookie.
EXPOSE_AUTH_TOKEN=false

# Comma-separated frontend origins allowed to send credentialed cross-origin requests.
# Leave empty when frontend and backend are served from the same origin.
CORS_ORIGINS=

# Configure only when the server runs behind a trusted reverse proxy.
# Use 1 for one proxy hop, such as a single Nginx or managed ingress layer.
# Leave empty when the Node server is exposed directly.
TRUST_PROXY=

# Maximum JSON request size. Increase only when notebook/image sync requires it.
JSON_BODY_LIMIT=10mb

# Maximum text/plain payload accepted by the authenticated sendBeacon sync endpoint.
SYNC_BEACON_BODY_LIMIT=10mb

# Maximum duration for outbound AI provider requests.
# Values below 5000ms are raised to 5000ms; values above 300000ms are capped.
AI_REQUEST_TIMEOUT_MS=120000

# Keep false in production to block AI requests to localhost and private networks.
# Enable only when the AI provider is intentionally hosted on a trusted internal network.
ALLOW_LOCAL_AI=false

# Bilingual App Integration (Server-to-Server)
BILINGUAL_APP_URL=http://127.0.0.1:27099
BILINGUAL_CLIENT_ID=replace-with-a-random-server-to-server-secret

# Comma-separated hostnames that BILINGUAL_APP_URL may target.
# localhost, 127.0.0.1 and ::1 are always allowed for local installations.
BILINGUAL_ALLOWED_HOSTS=
